# PostgreSQL connection string (local, Supabase, Neon or Replit Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flowdesk
# Set to true if your provider needs TLS and the URL has no sslmode=require
PGSSL=false

# API / realtime server port (also serves the built frontend in production)
PORT=3001

# Optional: comma-separated emails that are always platform admins (/app/admin).
# Without it, the first account created on the installation is the admin.
ADMIN_EMAILS=

# Optional: comma-separated origins allowed to open a Socket.io connection
# CORS_ORIGIN=https://flowdesk.example.com

# Set to production behind HTTPS so the session cookie is marked Secure
# NODE_ENV=production

# Which proxies may set X-Forwarded-For/-Proto (default: private networks only)
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Realtime transport: "socket" (Socket.io, long-lived servers) or "poll" (serverless).
# Defaults to "poll" on Vercel and "socket" everywhere else.
# REALTIME_MODE=

# Transactional email (verification + password reset) via Resend (https://resend.com).
# Without it, email verification is not required and "Olvidé mi contraseña" is disabled.
# RESEND_API_KEY=re_xxx
# Sender on a domain verified in Resend (onboarding@resend.dev only delivers to your own address)
# EMAIL_FROM=FlowDesk <hola@tudominio.com>
# Public URL used in email links (defaults to the request host)
# APP_URL=https://tu-app.vercel.app
# Local development: print emails (and their links) to the server log instead of sending
# EMAIL_TRANSPORT=console
